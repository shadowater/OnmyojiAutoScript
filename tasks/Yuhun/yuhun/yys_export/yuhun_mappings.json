      "0级": "副属性比例和 < 3.8",
      "3级": "3.8 ≤ 比例和 < 4.5",
      "6级": "4.5 ≤ 比例和 < 5.5",
      "9级": "5.5 ≤ 比例和 < 6.5",
      "12级": "6.5 ≤ 比例和 < 7.5",
      "15级": "比例和 ≥ 7.5"
    },
    "御魂类型ID解码": "suit_id = ((others >> 20) & 0xFFFF) + 0x40000"
  }
